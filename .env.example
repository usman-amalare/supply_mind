# SupplyMind environment names.
# Copy this file to .env at the repository root. Never commit .env.
# Empty values are blanks, not usable secrets.
# ASSUMED marks a name or default that is not stated in the master prompt.
# Do not treat ASSUMED defaults as approved product decisions.

# Required. development, test, or production.
APP_ENV=development

# Required. The application has no built-in secret.
# Generate a value of at least 32 characters. Placeholder words are rejected.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=

# Required. The user and password below are the local Compose example only.
# Production startup rejects this example credential pair.
DATABASE_URL=postgresql+psycopg://supplymind:supplymind@localhost:5432/supplymind

# ASSUMED name. Application default is INFO.
LOG_LEVEL=INFO

# Comma-separated browser origins. Empty in the application means same-origin only.
# The localhost value is the usual Vite dev origin (ASSUMED) for a later frontend stage.
# Production requires at least one https:// origin (ASSUMED operational rule).
FRONTEND_ORIGINS=http://localhost:5173

# Session behaviour is required. Durations and cookie names are ASSUMED.
SESSION_COOKIE_NAME=supplymind_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_IDLE_TIMEOUT_HOURS=1

# CSRF header. The name is ASSUMED. Route enforcement begins with identity.
CSRF_HEADER_NAME=X-CSRF-Token

# Named in the master prompt. No model id and no prices are built in.
# Leave blank until the provider's current documentation is checked.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_S=30
OPENAI_PRICE_INPUT_PER_M=
OPENAI_PRICE_OUTPUT_PER_M=

# Specified default: false. Product names stay off the explanation request.
AI_SEND_PRODUCT_NAMES=false

# No monthly cap is stated in either specification.
# Empty means live explanation calls stay disabled. This is not an approved budget.
AI_MONTHLY_TOKEN_CAP=
AI_MONTHLY_COST_CAP=

# Specified defaults: 5 MB and 50,000 rows. Variable names are ASSUMED.
CSV_MAX_BYTES=5000000
CSV_MAX_ROWS=50000

# No exchange-rate provider has been verified. manual is the only allowed value.
FX_PROVIDER=manual
# Specified: refresh every 6 hours; stale after 48 hours.
FX_STALENESS_HOURS=48
FX_REFRESH_INTERVAL_HOURS=6

# Local Mailpit defaults. Variable names are ASSUMED.
# Leave the password empty.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=supplymind@localhost
SMTP_USE_TLS=false
